    "scope_decision": {
      "policy": "NAMED ENTITIES ONLY. Concept- and domain-level phrases are NOT anonymized.",
      "not_anonymized": ["military and warfare", "intelligence community", "capped-profit", "public benefit corporation", "non-disparagement agreement"],
      "rationale": "These are policy categories and legal forms, not named entities. Replacing them would remove the semantic content the framework is designed to reason over (the tension in the defence signal is only legible if 'military and warfare' is readable) and would test something other than entity memorization. Keeping the scope at named entities also matches the claim made in the paper.",
      "to_override": "Add an entry under a new 'topics' category with a single-token placeholder, e.g. {\"military and warfare\": \"TopicKaevrin\"}, and re-run. Report it as domain-level rather than entity-level anonymization."
    },
  
    "lowercase_aliases": {
      "openai": "orgvrein",
