{
    "_meta": {
      "name": "wiki-openai-anonymization-map",
      "version": "2.0",
      "purpose": "Surface-level entity anonymization of the Wiki-OpenAI benchmark, used for the contamination ablation (reviewer R1-W1). Applied at prompt-rendering time; the underlying DTKG structure, relation types, timestamps and annotations are unchanged.",
      "application": "Case-insensitive, longest-surface-form-first, word-boundary-anchored replacement. Apply to: fact text, subject, object, off_narrative_rationale, and the anchor-word sets A(s) used by the scorer.",
      "placeholder_scheme": {
        "format": "Single token, letters only, >=2 characters, unique per entity. Survives r'[a-zA-Z][a-zA-Z]+' as ONE token in every baseline tokenizer and in the scorer, so all methods are scored under identical tokenization.",
        "prefixes": "Org / Person / Model / Prod / Gov / Media / Univ / Loc / Doc / Event / Topic — type is already in the DTKG schema.",
        "families": "Related entities share a stem plus a NATO-alphabet suffix (e.g. OrgX, OrgXAlfa, OrgXBravo) and remain distinct tokens, so document frequency and IDF are unaffected."
      },
      "notes": "Placeholders preserve entity TYPE but not identity. Type is already encoded in the DTKG schema, so preserving it introduces no information the model would not otherwise have.",
      "supersedes": "v1.0 used hyphenated placeholders (Person-13, Org-A). Baseline tokenizers split these, collapsing all people to 'person' and all organizations to 'org' while the scorer kept them intact. Results produced with v1.0 are not comparable across methods."
    },
    "replacement_rules": {
      "strategy": "longest_first",
      "case_insensitive": false,
      "word_boundary": true,
      "apply_to_fields": [
        "text",
        "subject",
        "object",
        "off_narrative_rationale",
        "anchor_words"
      ],
      "do_not_modify": [
        "event_date",
        "role",
        "precursor_of",
        "lead_time_days",
        "lead_tier",
        "domain",
        "provenance"
      ],
      "rationale": "Case-SENSITIVE matching is required. Case-insensitive replacement corrupts common words: 'US' would match inside 'US$1 billion', 'Multi' would match 'multi-purpose', 'Edge' would match 'edge', 'io' would match arbitrary fragments. All corpus surface forms are properly capitalised, so case-sensitive matching is sufficient; lowercase node labels are handled by the explicit aliases below.",
      "ambiguous_terms_requiring_review": [
        "Multi",
        "io",
        "OG",
        "Edge",
        "Canvas",
        "Universe",
        "Operator",
        "Roi",
        "The Times"
      ],
      "placeholder_token_pattern": "^[a-zA-Z][a-zA-Z]+$"
    },
